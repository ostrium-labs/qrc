{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheCacheBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::rust-cache"]
    },
    {
      "Sid": "ReadAndWriteCacheEntries",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": ["arn:aws:s3:::rust-cache/*"]
    }
  ]
}
