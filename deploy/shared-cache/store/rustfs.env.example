# RustFS settings for the shared cache store, installed as /etc/rustfs/rustfs.env
# (mode 0640, owner root, group rustfs). Values in angle brackets are placeholders:
# no real address or secret belongs in this repository.

# The tailnet address only (`tailscale ip -4` on the store box), never 0.0.0.0, so the
# S3 port does not exist on any other interface (docs/tailscale-shared-cache.md §2.1).
RUSTFS_ADDRESS=<build-cache-tailnet-ip>:9000

RUSTFS_VOLUMES=/srv/rustfs/data
RUSTFS_REGION=us-east-1

# The root credentials live in their own files (mode 0640, owner root, group rustfs),
# created once with `openssl rand -hex 20`; only setup.sh and the owner use them.
RUSTFS_ACCESS_KEY_FILE=/etc/rustfs/root-access-key
RUSTFS_SECRET_KEY_FILE=/etc/rustfs/root-secret-key

# No web console: the owner manages the store with `rc` on the box itself.
RUSTFS_CONSOLE_ENABLE=false
