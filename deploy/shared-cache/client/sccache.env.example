# Shared build cache settings for a maintainer laptop (docs/tailscale-shared-cache.md §6.4).
#
# Copy this file somewhere private, for example ~/.config/qrc-cache/sccache.env, replace
# the values in angle brackets, and source it from your shell profile, or from a direnv
# .envrc in your loams checkout so that it applies only there:
#
#   . ~/.config/qrc-cache/sccache.env
#
# Checked against sccache v0.18.0 (docs/S3.md and docs/Configuration.md at that tag).
# Check the names again whenever the pinned sccache version changes. Values in angle
# brackets are placeholders: no real tailnet name or key belongs in any repository.

# The store, reachable on the tailnet only.
export SCCACHE_BUCKET=rust-cache
export SCCACHE_ENDPOINT="http://<build-cache-tailnet-name>:9000"
export SCCACHE_REGION=us-east-1            # the RUSTFS_REGION of the store
export SCCACHE_S3_USE_SSL=false            # plain HTTP, but inside the encrypted tailnet
# Path-style addressing (http://<host>:9000/rust-cache/<key>) is sccache's default and is
# what RustFS serves. Do not set SCCACHE_S3_ENABLE_VIRTUAL_HOST_STYLE.

# One prefix per toolchain and target (§3.6), with the same formula as the CI step: the
# "release" and "host" lines of `rustc -vV`, run in your loams checkout.
export SCCACHE_S3_KEY_PREFIX="<rustc release>/<host target>"  # for example 1.97.1/x86_64-unknown-linux-gnu

export SCCACHE_IGNORE_SERVER_IO_ERROR=1
# sccache cannot cache incremental builds, and stops with an error if CARGO_INCREMENTAL=1.
export CARGO_INCREMENTAL=0

# As in the plan (§4). These flags make paths in the build output independent of where
# the checkout is. They do not make cache keys match across machines: sccache 0.18.0
# hashes the working directory, the full rustc argument list (these flags included) and
# the CARGO_* variables with their absolute paths. Entries are therefore shared only
# between machines with the same checkout path, the same CARGO_HOME path and the same
# RUSTFLAGS. The CI step sets no RUSTFLAGS. RUSTFLAGS also replaces the rustflags of
# every Cargo config file, so copy any that loams adds later.
export RUSTFLAGS="--remap-path-prefix=<path to your loams checkout>=/workspace --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"

# Your own read-write key, from the key file the owner sent you over a private channel
# the owner chose. Keep that file mode 0600 and outside every repository. It sets
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, which the aws CLI also reads: if you use
# AWS for other work, source this file from a direnv .envrc in loams instead.
set -a
# shellcheck source=/dev/null
. "<path to your maintainer-<name>.env key file>"
set +a

# Turn the wrapper on only when the store answers. If the store cannot be reached when
# the sccache server starts, sccache 0.18.0 does not start the server and every compile
# fails, with or without SCCACHE_IGNORE_SERVER_IO_ERROR (that setting only covers errors
# after the server is up). So: if a build fails with "sccache: error: Server startup
# failed", run `unset RUSTC_WRAPPER`, or `sccache --stop-server` and source this file
# again once you are back on the tailnet.
if curl -fsS --max-time 2 -o /dev/null "$SCCACHE_ENDPOINT/health" 2> /dev/null; then
  export RUSTC_WRAPPER=sccache
else
  unset RUSTC_WRAPPER
  echo "qrc shared cache: $SCCACHE_ENDPOINT did not answer, building without it" >&2
fi
